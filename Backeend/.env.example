# Server Port
PORT=8024

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DarkStore?retryWrites=true&w=majority

# Razorpay Keys (for Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Settings (for Password Reset OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Optional: Brevo SMTP settings
# BREVO_SMTP_USER=your_brevo_user
# BREVO_SMTP_PASS=your_brevo_pass
